{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || !data.child('hostUid').exists() || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChild('createdAt')",
          "hostUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "started": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'z', 'yaw', 'alive', 'health'])",
            "x": { ".validate": "newData.isNumber() && newData.val() > -300 && newData.val() < 300" },
            "z": { ".validate": "newData.isNumber() && newData.val() > -300 && newData.val() < 300" },
            "health": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" }
          }
        },
        "soundEvents": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'z', 'intensity', 'radius', 'type', 't'])"
          }
        },
        "monster": {
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid",
          "$mid": { ".validate": "newData.hasChildren(['x', 'y', 'z', 'yaw', 'aiState'])" }
        },
        "vehicles": {
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid",
          "$vid": { ".validate": "newData.hasChildren(['type', 'x', 'z', 'yaw'])" }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['gameOver', 'win'])"
        },
        "billboard": {
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['url', 'type', 'by', 't']) && newData.child('url').isString() && newData.child('url').val().beginsWith('https://firebasestorage.googleapis.com/')"
        }
      }
    }
  }
}
