rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Path: billboard/{roomCode}/{uid}/{file}
    // roomCode may be multiplayer code or "solo"
    match /billboard/{room}/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && room.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp|video/mp4');
    }
  }
}
